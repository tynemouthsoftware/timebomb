   434                          ;======================================================================================
   435                          ; Ominous ticking
   436                          ;======================================================================================
   437                          ; 7 for t = 1 to 2 : poke v, t*4 : poke s+1, 128+k/5 : next : poke s+1, 0
   438                          L7: 
   439  1200 a904                   lda #4                              ; pass 1, t*4 = 4
   440  1202 8500                   sta TEMP   
   441                          
   442                          L7_1:
   443  1204 8d0e90                 sta VIC_VOLUME                      ; v
   444                          
   445                              ; pokes+1,128+k/5  - really, come on, give me a break here
   446                              ; max K is 600, so max k/5 is 120. So range is 128-248
   447                              
   448  1207 a53d                   lda K_TENS                          ; this is K/10
   449  1209 0a                     asl                                 ; k/10 -> K/5
   450  120a 0980                   ora #$80                            ; add 128
   451                          
   452  120c 8d0b90                 sta VIC_OSC2_FREQ                   ; s+1
   453                          
   454  120f a208                   ldx #$08
   455  1211 88                 -   dey                                 ; short delay
   456  1212 d0fd                   bne -                               ;
   457  1214 ca                     dex                                 ;
   458  1215 d0fa                   bne -                               ;
   459                          
   460  1217 a908                   lda #8                              ; was TEMP 8 ?
   461  1219 c500                   cmp TEMP
   462  121b f004                   beq L7_2                            ; finished
   463                          
   464  121d 8500                   sta TEMP                            ; no, set it to 8 now
   465  121f d0e3                   bne L7_1                            ; branch always
   466                          
   467                          L7_2:
   468  1221 8c0b90                 sty VIC_OSC2_FREQ                   ; s+1 = 0
   469                          
   470                          ;======================================================================================
   471                          ; Check joystick and move
   472                          ;======================================================================================
   473                          ; 8 poke d, 127 : p = peek(p2) and 128 : j0 = -(p = 0)
   474                          ; 9 poke d, 255 : p = peek(p1) : j1 = -((p and 8) = 0) : j2 = -((p and 16) = 0) : j3 = -((p and 4) = 0)
   475                          ; 10 if j0 then c = 1 : m1 = 62 : goto 14
   476                          ; 11 if j1 then c = 22 : m1 = 22 : goto 14
   477                          ; 12 if j2 then c = -1 : m1 = 60 : goto 14
   478                          ; 13 if j3 then c = -22 : m1 = 30
   479                          L8:
   480                          
   481  1224 a97f                   lda #$7F                            ; set joystick 3 as input
   482  1226 8d2291                 sta VIA2_DDRB
   483                          
   484  1229 ad2091                 lda VIA2_PORTB                      ; read the port
   485                          
   486  122c a2ff                   ldx #$FF
   487  122e 8e2291                 stx VIA2_DDRB                       ; back to all inputs for keyboard scanning
   488                          
   489  1231 2980                   and #$80                            ; mask of the pin
   490  1233 d00b                   bne +                               ; skip if not zero (active)
   491  1235 a901                   lda #MOVE_RIGHT
   492  1237 8554                   sta C
   493  1239 a93e                   lda #CHAR_RIGHT
   494  123b 8553                   sta M1
   495  123d 4c7012                 jmp L14
   496                          +
   497                          
   498  1240 ad1f91                 lda VIA1_PORTA                      ; read port A and set J1,2 and 3 accordingly
   499  1243 aa                     tax                                 ; save value
   500                          
   501  1244 2908                   and #8
   502  1246 d00b                   bne +                               ; skip if not zero (active)
   503  1248 a916                   lda #MOVE_DOWN
   504  124a 8554                   sta C
   505  124c a916                   lda #CHAR_DOWN
   506  124e 8553                   sta M1
   507  1250 4c7012                 jmp L14
   508                          +
   509  1253 8a                     txa                                 ; get back the port reading
   510  1254 2910                   and #16
   511  1256 d00b                   bne +                               ; skip if not zero (active)
   512  1258 a9ff                   lda #MOVE_LEFT
   513  125a 8554                   sta C
   514  125c a93c                   lda #CHAR_LEFT
   515  125e 8553                   sta M1
   516  1260 4c7012                 jmp L14
   517                          +
   518  1263 8a                     txa                                 ; get back the port reading
   519  1264 2904                   and #4
   520  1266 d008                   bne +                               ; skip if not zero (active)
   521  1268 a9ea                   lda #MOVE_UP
   522  126a 8554                   sta C
   523  126c a91e                   lda #CHAR_UP
   524  126e 8553                   sta M1
   525                          +
   526                          
   527                          ; 14 om = me : me = me+c : c = 0
   528                          L14:
   529  1270 a538                   lda ME_LSB                          ; old me = current me
   530  1272 853a                   sta OM_LSB
   531  1274 a539                   lda ME_MSB
   532  1276 853b                   sta OM_MSB
   533                          
   534  1278 a554                   lda C                               ; me=me+c - move me
   535  127a 1002                   bpl +
   536  127c c639                   dec ME_MSB                          ; if c is negative, decrement the MSB
   537  127e 18                 +   clc
   538  127f 6538                   adc ME_LSB
   539  1281 8538                   sta ME_LSB
   540  1283 9002                   bcc +
   541  1285 e639                   inc ME_MSB
   542                          +   
   543  1287 8454                   sty C                               ; c=0 
   544                          
   545                          ; 15 if peek(me) <> 32 and peek(me) <> 42 then me = om
   546  1289 b138                   lda (ME),y
   547                          
   548  128b c920                   cmp #CHAR_PATH                      ; is it a clear path?
   549  128d f00c                   beq L16                             ; yes, skip
   550                          
   551  128f c92a                   cmp #CHAR_BOMB                      ; is it a bomb?
   552  1291 f008                   beq L16                             ; yes, skip
   553                          
   554  1293 a63a                   ldx OM_LSB                          ; me = old me - you can't want into walls
   555  1295 8638                   stx ME_LSB
   556  1297 a63b                   ldx OM_MSB
   557  1299 8639                   stx ME_MSB
   558                          
   559                          ; 16 if peek(me) = 42 then f = 1 : goto 5
   560                          L16:
   561  129b c92a                   cmp #CHAR_BOMB                      ; is it a bomb?
   562  129d d007                   bne L17                             ; no, skip
   563                          
   564  129f a901                   lda #1                              ; it is a bomb, set found
   565  12a1 8552                   sta F
   566  12a3 4cae11                 jmp L5
   567                          
   568                              
   569                          ; 17 if (me>7921) goto 18 else sys 887 : me = me+22 : goto 5
   570                          L17:
   571  12a6 a539                   lda ME_MSB                           ; if me>1EF1 goto 18
   572  12a8 c91e                   cmp #$1E
   573  12aa d004                   bne +
   574  12ac a538                   lda ME_LSB
   575  12ae c9f1                   cmp #$F1
   576                          +
   577  12b0 b011                   bcs L18
   578                          
   579  12b2 20cc13                 jsr sys887                          ; scroll down
   580                          
   581  12b5 a538                   lda ME_LSB                          ; me += 22 
   582  12b7 18                     clc
   583  12b8 6916                   adc #MOVE_DOWN
   584  12ba 8538                   sta ME_LSB
   585  12bc 9002                   bcc +
   586  12be e639                   inc ME_MSB
   587                          +
   588  12c0 4cae11                 jmp L5
   589                          
   590                          ; 18 if (me<7944) goto 5 else sys 905 : me = me-22 : goto 5
   591                          L18
   592  12c3 a539                   lda ME_MSB                          ; is ME < 1F08
   593  12c5 c91f                   cmp #$1F
   594  12c7 d004                   bne +
   595  12c9 a538                   lda ME_LSB
   596  12cb c908                   cmp #$08
   597                          +
   598  12cd 9010                   bcc +
   599                          
   600  12cf 20d313                 jsr sys905                          ; scroll up
   601                          
   602  12d2 a538                   lda ME_LSB                          ; me += -22
   603  12d4 c639                   dec ME_MSB
   604  12d6 18                     clc
   605  12d7 69ea                   adc #MOVE_UP
   606  12d9 8538                   sta ME_LSB
   607  12db 9002                   bcc +
   608  12dd e639                   inc ME_MSB
   609                          +
   610  12df 4cae11                 jmp L5
   611                          
   612                          ;===================================================================================================
   613                          ; Timeout, bomb explodes
   614                          ;===================================================================================================
   615                          ; 37 poke v, 15 : for t = 255 to 127 step -2 : poke s, t : poke v-9, 255 : for g = 1 to 10 : next
   616                          L37:
   617  12e2 a90f                   lda #15                             ; full volume
   618  12e4 8d0e90                 sta VIC_VOLUME
   619                          
   620  12e7 a2ff                   ldx #$FF
   621                          L37_1:
   622  12e9 8e0a90                 stx VIC_OSC1_FREQ                   ; s = t
   623                          
   624  12ec a9ff                   lda #$FF
   625  12ee 8d0590                 sta VIC_ADDRESSING                  ; v-9 = 255
   626                          
   627  12f1 a209                   ldx #$09                            ; short delay
   628  12f3 88                 -   dey                                 ;
   629  12f4 d0fd                   bne -                               ;
   630  12f6 ca                     dex                                 ;
   631  12f7 d0fa                   bne -                               ;
   632                          
   633                          ; 38 poke v-9, 242 : for g = 1 to 10 : next : poke v-9, 240 : next : poke v-1, 220 : for g = 15 to 0 step -.05
   634  12f9 a9f2                   lda #$F2
   635  12fb 8d0590                 sta VIC_ADDRESSING                  ; v-9 = 242
   636                          
   637  12fe a209                   ldx #$09                            ; short delay
   638  1300 88                 -   dey                                 ;
   639  1301 d0fd                   bne -                               ;
   640  1303 ca                     dex                                 ;
   641  1304 d0fa                   bne -                               ;
   642                          
   643  1306 ae0a90                 ldx VIC_OSC1_FREQ                   ; get X back
   644                          
   645  1309 a9f0                   lda #$F0
   646  130b 8d0590                 sta VIC_ADDRESSING                  ; v-9 = 240
   647                          
   648  130e ca                     dex                                 ; t=t-2
   649  130f ca                     dex
   650  1310 30d7                   bmi L37_1                           ; loop when t > 127
   651                          
   652                              ; now the explosion
   653                          
   654  1312 a9dc                   lda #$DC
   655  1314 8d0d90                 sta VIC_NOISE_FREQ                  ; v-1 = 220
   656                          
   657                          ; for g = 15 to 0 step -.05   oh no, what?
   658                          
   659                          ; 39 poke v, g : poke v+1, g*10 : next : poke v-1, 0 : poke v+1, 238 : gosub 42 : run
   660                          L39:
   661  1317 a996                   lda #$96                            ; v+1 = g*10
   662  1319 8d0f90                 sta VIC_BORDER            
   663                          
   664  131c a90f                   lda #$0F                            ; v = g
   665  131e 8d0e90                 sta VIC_VOLUME
   666                          
   667  1321 a20a                   ldx #$0A                            ; loop 10 times
   668                          
   669  1323 88                 -   dey                                 ; delay
   670  1324 d0fd                   bne -
   671                          
   672  1326 ce0f90                 dec VIC_BORDER                      ; v+1 = g*10
   673  1329 ca                     dex
   674  132a d0f7                   bne -
   675                          
   676  132c ce0e90                 dec VIC_VOLUME                      ; v = g
   677  132f d0f2                   bne -
   678                          
   679  1331 8c0d90                 sty VIC_NOISE_FREQ                  ; v-1 = 0 
   680                          
   681  1334 a9ee                   lda #$EE                            ; v+1 = 238
   682  1336 8d0f90                 sta VIC_BORDER            
   683                          
   684  1339 208713                 jsr L42                             ; display "ROUND R, PRESS F7"
   685                          
   686  133c 4c1710                 jmp L1                              ; restart
   687                          
   688                          ;===================================================================================================
   689                          ; Success
   690                          ;===================================================================================================
   691                          
   692                          ; 40 poke tb, 32 : poke v-1, 253 : for g = 30 to 0 step -.15 : poke v, g/2 : next : x = x+50 : if x>449 then x = 450
   693                          L40:
   694  133f a920                   lda #CHAR_PATH                     ; dispose of the timebomb
   695  1341 9136                   sta (TB),y
   696                          
   697  1343 a9fd                   lda #$FD
   698  1345 8d0d90                 sta VIC_NOISE_FREQ                  ; v-1 = 253
   699                          
   700                              ; for g = 30 to 0 step -.15  oh come on, give me a break
   701  1348 a20f                   ldx #$0F                            ; g = 30, x = g/2 = 15
   702                          
   703                          L40_1:    
   704  134a 8e0e90                 stx VIC_VOLUME                      ; v = g/2 = x
   705                          
   706  134d a235                   ldx #$35                            ; delay
   707  134f 88                 -   dey                                 ;
   708  1350 d0fd                   bne -                               ;
   709  1352 ca                     dex                                 ;
   710  1353 d0fa                   bne -                               ;
   711                          
   712  1355 ae0e90                 ldx VIC_VOLUME                      ; get X back
   713                          
   714  1358 ca                     dex
   715  1359 d0ef                   bne L40_1
   716                          
   717  135b 18                     clc
   718  135c a53f                   lda X_TENS                          ; x = x+50
   719  135e 6905                   adc #$05
   720  1360 853f                   sta X_TENS
   721                          
   722  1362 c92d                   cmp #$2D                            ; x > 450 ?
   723  1364 9004                   bcc L41
   724                          
   725  1366 a92d                   lda #$2D                            ; x = 450
   726  1368 853f                   sta X_TENS                          ; X_UNITS is always 0
   727                          
   728                          ; 41 poke v-1, 0 : f = 0 : k = x : r = r+1 : gosub 42 : goto 27
   729                          L41:
   730  136a 8c0d90                 sty VIC_NOISE_FREQ                  ; v-1 = 0
   731                          
   732  136d 8452                   sty F                               ; f = 0
   733                          
   734  136f a53f                   lda X_TENS                          ; k = x, start K counter at X
   735  1371 853d                   sta K_TENS
   736  1373 843c                   sty K_UNITS                         ; X_UNITS is always 0
   737                              
   738  1375 e640                   inc R_UNITS                         ; r = r+1
   739  1377 a540                   lda R_UNITS
   740  1379 c90a                   cmp #10
   741  137b 9004                   bcc +
   742  137d 8440                   sty R_UNITS                         ; if R_UNITS>9 then R_UNITS=0 R_TENS++
   743  137f e641                   inc R_TENS
   744                          +  
   745  1381 208713                 jsr L42                             ; display "ROUND R, PRESS F7"
   746                          
   747  1384 4c3111                 jmp L27                             ; next round
   748                          
   749                          ;===================================================================================================
   750                          ; Print ROUND R - PRESS F7
   751                          ;===================================================================================================
   752                          ; 42 print "{home}round" r "{right} " : print "{down}press f7 " : a$ = "" : get a$ : if (a$ <> "{f7}") goto 42 else return
   753                          L42:
   754  1387 a207bd1a149d001e...    +WriteString TEXT_ROUND_x_LEN, TEXT_ROUND_x, 0, 0, COLOUR_BLUE
   755                          
   756  1397 a541                   lda R_TENS
   757  1399 f010                   beq L42_1
   758                          
   759                              ; double digit
   760  139b 18                     clc    
   761  139c 6930                   adc #$30                            ; A = R+30  (0->"0")
   762  139e 8d061e                 sta SCREEN_RAM + 6                 
   763                          
   764  13a1 a540                   lda R_UNITS
   765  13a3 18                     clc
   766  13a4 6930                   adc #$30                            ; A = R+30  (0->"0")
   767  13a6 8d071e                 sta SCREEN_RAM + 7                  
   768  13a9 d008                   bne L42_2                           ; branch always
   769                          
   770                          L42_1:
   771                              ; single digit
   772  13ab a540                   lda R_UNITS
   773  13ad 18                     clc
   774  13ae 6930                   adc #$30                            ; A = R+30  (0->"0")
   775  13b0 8d061e                 sta SCREEN_RAM + 6                  
   776                          
   777                          L42_2:
   778  13b3 a207bd22149d2c1e...    +WriteString TEXT_PRESS_F7_LEN, TEXT_PRESS_F7, 2, 0, COLOUR_BLUE
   779                          
   780  13c3 84c5                   sty LAST_KEY                        ; clear last key
   781                          -
   782  13c5 a5c5                   lda LAST_KEY                        ; check last key pressed
   783  13c7 c93f                   cmp #KEY_F7                         ; was it F7?
   784  13c9 d0fa                   bne -                               ; no, keep checking
   785                              
   786  13cb 60                     rts                                 ; yes, return
   787                          

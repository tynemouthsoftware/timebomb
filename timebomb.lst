    96                          ;======================================================================================
    97                          ; Screen layout
    98                          ;======================================================================================
    99                          SCREEN_RAM              = $1E00
   100                          SCREEN_RAM_PAGE0        = SCREEN_RAM + $0000
   101                          SCREEN_RAM_PAGE1        = SCREEN_RAM + $0100
   102                          END_OF_SCREEN_RAM       = $1FFF
   103                          
   104                          COLOUR_RAM              = $9600
   105                          COLOUR_RAM_PAGE0        = COLOUR_RAM + $0000
   106                          COLOUR_RAM_PAGE1        = COLOUR_RAM + $0100
   107                          
   108                          SCREEN_WIDTH            = 22
   109                          SCREEN_HEIGHT           = 23
   110                          
   111                          COLOUR_RAM_OFFSET_MSB   = (>COLOUR_RAM) - (>SCREEN_RAM)
   112                          
   113                          SCREEN_RAM_LINE_00      = SCREEN_RAM + (SCREEN_WIDTH *  0)
   114                          SCREEN_RAM_LINE_02      = SCREEN_RAM + (SCREEN_WIDTH *  2)
   115                          
   116                          COLOUR_RAM_LINE_00      = COLOUR_RAM + (SCREEN_WIDTH *  0)
   117                          COLOUR_RAM_LINE_02      = COLOUR_RAM + (SCREEN_WIDTH *  2)
   118                          

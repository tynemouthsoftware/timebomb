    15                          
    16                          ; BASIC loader stub
    17                          ; 6502 SYS 4109
    18                          *=$1001
    19  1001 0b10                   !word end_of_stub                   ; link to next line (end of BASIC stub)
    20  1003 6619                   !word 6502                          ; line number (can be anything, so why not)
    21  1005 9e                     !byte SYS                           ; SYS token
    22  1006 34313039               !text "4109"                        ; start of init code ($100D)
    23  100a 00                     !byte 0                             ; end of line
    24                          end_of_stub
    25  100b 0000                   !word 0                             ; end of BASIC stub
    26                          
    27                          ;===================================================================================================
    28                          ; Starting point
    29                          ;===================================================================================================
    30                          ; start:
    31  100d ad1891                 lda VIA1_TIMER2_LSB                 ; seed RND from the VIA timer
    32  1010 8510                   sta SEED_LSB
    33  1012 ad1991                 lda VIA1_TIMER2_MSB
    34  1015 8511                   sta SEED_MSB
    35                          
    36                          L1:
    37  1017 a000                   ldy #0                              ; (leave Y as 0)
    38                          
    39                          ; some variables that are initialised to 0 by BASIC
    40  1019 8452                   sty F                               ; f = 0
    41  101b 8440                   sty R_UNITS                         ; r = 0
    42  101d 8441                   sty R_TENS                          ;
    43  101f 843c                   sty K_UNITS                         ; k = 0
    44  1021 843d                   sty K_TENS                          ; 
    45                          
    46                          ; 2 poke 56, 24 : poke 55, 103 : gosub 29
    47                              ; set memory limits, normally $1E00 to $1867
    48                              ; stops the BASIC heap getting in the way of the maze - not required
    49                              ; gosub 29 not required as that pokes assembler from data statments into the cassette buffer
    50                          
    51                          ; 3 d = 37154 : p1 = d-3 : p2 = d-2 : df = 30720 : v = 36878 : s = v-4 : m1 = 30 : x = 50 : goto 19
    52                          ; d  = constant = 37154 = 9122 = VIA#2 DDRB (keyboard column scan + joy3)
    53                          ; p1 = constant = 37151 = 911F = VIA#1 PortA (joy0,1,2,fire)
    54                          ; p2 = constant = 37152 = 9120 = VIA#2 PortB (joy3)
    55                          ; df = constant = 30720 = 7800 = display offset
    56                          ; v  = constant = 36878 = 900E = VIC volume / aux colour
    57                          ; s  = constant = 36874 = 900A = VIC oscillator 1 frequency
    58                          L3:
    59  1023 a91e                   lda #CHAR_UP                        ; m1 = 30 = ^
    60  1025 8553                   sta M1
    61                          
    62  1027 a905                   lda #5                              ; x = 50
    63  1029 853f                   sta X_TENS                          ; Tens and units stored separately to avoid several divide by 10s
    64                                                                  ; (X_UNITS is always 0, so is optimised out)
    65                          
    66                          ;===================================================================================================
    67                          ; Draw the maze
    68                          ;===================================================================================================
    69                          ; 19 dim a(3) : a(0) = 2 : a(1) = -44 : a(2) = -2 : a(3) = 44 : wl = 209 : hl = 32 : sc = 6228 : a9 = 6943
    70                          L19:
    71                          ; a = 2, -44, -2, 44
    72  102b a902                   lda #2
    73  102d 8520                   sta ARRAY
    74  102f a9d4                   lda #-44
    75  1031 8521                   sta ARRAY+1
    76  1033 a9fe                   lda #-2
    77  1035 8522                   sta ARRAY+2
    78  1037 a92c                   lda #44
    79  1039 8523                   sta ARRAY+3
    80                          
    81                          ; also create a half value version to avoid having to recalculate each time
    82  103b a901                   lda #1
    83  103d 8524                   sta ARRAY_HALF
    84  103f a9ea                   lda #-22
    85  1041 8525                   sta ARRAY_HALF+1
    86  1043 a9ff                   lda #-1
    87  1045 8526                   sta ARRAY_HALF+2
    88  1047 a916                   lda #22
    89  1049 8527                   sta ARRAY_HALF+3
    90                          
    91                          ; 20 sys 861 : print "{clear} {down}making maze"
    92                          ; wl=209 - constant "Wall" (inverse circle)
    93                          ; hl=32 - constant "Hall" (space)
    94                          ; sc=6228
    95  104b a954                   lda #<MAZE_TOP                      ; set SC and DST to 6228 ($1854), the top of the maze
    96  104d 850a                   sta DST_LSB
    97  104f 8530                   sta SC_LSB
    98  1051 a918                   lda #>MAZE_TOP
    99  1053 850b                   sta DST_MSB
   100  1055 8531                   sta SC_MSB
   101                          
   102                          ; a9=6943
   103  1057 a91f                   lda #<MAZE_MIDDLE                   ; set A9 to 6943 ($1B1F), about the middle of the maze
   104  1059 8532                   sta A9_LSB
   105  105b a91b                   lda #>MAZE_MIDDLE
   106  105d 8533                   sta A9_MSB
   107                          
   108                          ;===================================================================================================
   109                          ; SYS 861 - fill maze with walls
   110                          ;===================================================================================================
   111  105f a21e                   ldx #>MAZE_END+1                    ; end point
   112                          
   113  1061 a9d1                   lda #CHAR_WALL                      ; fill with wall characters
   114                          -
   115  1063 910a                   sta (DST),y 
   116  1065 e60a                   inc DST_LSB
   117  1067 d0fa                   bne -
   118  1069 e60b                   inc DST_MSB
   119  106b e40b                   cpx DST_MSB
   120  106d d0f4                   bne -
   121                          
   122                          ; 21 for t = sc+21 to 7679 step 22 : poke t, 32 : next : for t = sc to sc+21 : poke t, 32 : next
   123                              ; add all the spaces down the right hand side
   124  106f a918                   lda #>MAZE_END_OF_TOP_LINE          ; start at SC + 21
   125  1071 850b                   sta DST_MSB
   126  1073 a969                   lda #<MAZE_END_OF_TOP_LINE
   127  1075 850a                   sta DST_LSB
   128                          
   129  1077 a242                   ldx #MAZE_HEIGHT                    ; 66 times
   130                              
   131  1079 a920               -   lda #CHAR_PATH                      ; store a space
   132  107b 910a                   sta (DST),y
   133                          
   134  107d a50a                   lda DST_LSB                         ; add 22
   135  107f 18                     clc
   136  1080 6916                   adc #MAZE_WIDTH
   137  1082 850a                   sta DST_LSB
   138  1084 9002                   bcc +
   139  1086 e60b                   inc DST_MSB
   140                          +
   141  1088 ca                     dex                                 ; check if we have hit $1E00 (7679)
   142  1089 d0ee                   bne -
   143                          
   144                              ; add a row of spaces at the top  
   145  108b a920                   lda #CHAR_PATH                      ; store a space
   146  108d a216                   ldx #MAZE_WIDTH                     ; 22 times
   147                          
   148  108f ca                 -   dex
   149  1090 9d5418                 sta MAZE_TOP,x
   150  1093 d0fa                   bne -
   151                          
   152  1095 8dc81d                 sta MAZE_START_ME                   ; leave a space where the player starts
   153                          
   154                          ; make the paths
   155                          ; 22 j = int(rnd(1)*4) : x3 = j
   156                          L22:
   157  1098 20d213                 jsr RAND16                          ; get a random number
   158  109b 2903                   and #$03                            ; mask off all but the lower two bits (A=0-3)
   159                          
   160  109d 8551                   sta J
   161  109f 8550                   sta X3
   162                          
   163                          ; 23 b = a9 + a(j)
   164                          L23:
   165                              ; interesting challenge, add an 8 bit signed value to a 16 bit unsigned number
   166  10a1 a651                   ldx J                               ; get the random number in X
   167                          
   168  10a3 a533                   lda A9_MSB                          ; copy the MSB first so it can be adjusted based on what happens to the LSB
   169  10a5 8535                   sta B_MSB
   170                          
   171  10a7 b520                   lda ARRAY,x                         ; get the signed direction offset
   172  10a9 1002                   bpl +
   173  10ab c635                   dec B_MSB                           ; if the offset is negative, decrement the MSB
   174  10ad 18                 +   clc
   175  10ae 6532                   adc A9_LSB                          ; now add the LSB
   176  10b0 8534                   sta B_LSB
   177  10b2 9002                   bcc +
   178  10b4 e635                   inc B_MSB                           ; increment MSB if there was a carry
   179                          +
   180                          
   181                          ; 24 if peek(b) = wl then poke b, j : poke a9 + a(j)/2, hl : a9 = b : goto 22
   182  10b6 b134                   lda (B),y                           ; check what is pointed at by B, Y is 0
   183  10b8 c9d1                   cmp #CHAR_WALL                      ; is it a wall (wl)?
   184  10ba d02e                   bne L25
   185                          
   186  10bc a551                   lda J                               ; store the direction number instead
   187  10be 9134                   sta (B),y
   188                          
   189                              ; poke a9 +a(j)/2, hl  Oh boy.
   190                          
   191                              ; safe to mangle A9 as it is set to a different value later
   192                          
   193  10c0 b524                   lda ARRAY_HALF,x                    ; get half the signed direction offset
   194  10c2 1002                   bpl +
   195  10c4 c633                   dec A9_MSB                          ; if the offset is negative, decrement the MSB
   196  10c6 18                 +   clc
   197  10c7 6532                   adc A9_LSB                          ; now add the LSB
   198  10c9 8532                   sta A9_LSB
   199  10cb 9002                   bcc +
   200  10cd e633                   inc A9_MSB                          ; increment MSB if there was a carry
   201                          +
   202                          
   203  10cf a533                   lda A9_MSB                          ; check it's not the last line
   204  10d1 c91d                   cmp #>MAZE_LAST_LINE
   205  10d3 d004                   bne +
   206  10d5 a532                   lda A9_LSB
   207  10d7 c9ea                   cmp #<MAZE_LAST_LINE
   208  10d9 b004               +   bcs +                               ; skip if on last line
   209                          
   210  10db a920                   lda #CHAR_PATH                      ; set this to a space (hl)
   211  10dd 9132                   sta (A9),y
   212                          
   213  10df a535               +   lda B_MSB                           ; a9 = b
   214  10e1 8533                   sta A9_MSB
   215  10e3 a534                   lda B_LSB
   216  10e5 8532                   sta A9_LSB
   217                          
   218  10e7 4c9810                 jmp L22
   219                          
   220                          ; not a wall
   221                          ; 25 j = (j+1) * -(j<3) : if j <> x3 then 23
   222                          L25:   
   223                              ;   j   (j+1)*-(j<3)    =
   224                              ; -------------------------
   225                              ;   0     1  *   1      1
   226                              ;   1     2  *   1      2
   227                              ;   2     3  *   1      3
   228                              ;   3     4  *   0      0
   229                          
   230  10ea e651                   inc J                               ; 0123 > 1234
   231  10ec a551                   lda J                               ; 
   232  10ee 2903                   and #$03                            ; 1234 > 1230
   233  10f0 8551                   sta J                               ; 
   234  10f2 c550                   cmp X3                              ; = X3?
   235  10f4 d0ab                   bne L23
   236                          
   237                          ; 26 j = peek(a9) : poke a9, hl : if j<4 then a9 = a9-a(j) : goto 22
   238  10f6 b132                   lda (A9),y
   239  10f8 8551                   sta J
   240  10fa aa                     tax                                 ; save J for later
   241  10fb a920                   lda #CHAR_PATH 
   242  10fd 9132                   sta (A9),y
   243                          
   244  10ff e004                   cpx #4                              ; J<4?
   245  1101 b016                   bcs L27
   246                          
   247                              ; here we go again, subtract an 8 bit signed value from a 16 bit unsigned number
   248                          
   249  1103 b520                   lda ARRAY,x                         ; get signed direction offset
   250  1105 8500                   sta TEMP                            ; save for later
   251  1107 1002                   bpl +
   252  1109 e633                   inc A9_MSB                          ; if the offset is negative, increment the MSB
   253  110b 38                 +   sec
   254  110c a532                   lda A9_LSB                          ; now subtract the offset from the LSB
   255  110e e500                   sbc TEMP
   256  1110 8532                   sta A9_LSB
   257  1112 b002                   bcs +
   258  1114 c633                   dec A9_MSB                          ; decrement MSB if there was a carry
   259                          +
   260  1116 4c9810                 jmp L22
   261                          
   262                          ; Set the location of the timebomb
   263                          ; 27 tb = sc + int(rnd(0)*20) + 220 : if (peek(tb) <> 32) goto 27 else poke tb, 42
   264                          L27:
   265  1119 843a                   sty OM_LSB                          ; clear the old me position 
   266  111b 843b                   sty OM_MSB
   267                          
   268  111d a531                   lda SC_MSB                          ; start with the MSB.
   269  111f 8537                   sta TB_MSB
   270                          
   271                              ;   OK, so I want a random number from 0-19.
   272                          
   273  1121 20d213                 jsr RAND16                          ; A now contains an 8 bit random number
   274  1124 2903                   and #$03                            ; now have number from 0-3
   275  1126 8500                   sta TEMP                            ; save for later
   276  1128 a510                   lda SEED_LSB                        ; get another 8 bits of random number
   277  112a 290f                   and #$0F                            ; now have a number from 0-15
   278  112c 18                     clc
   279  112d 6500                   adc TEMP                            ; now add the number from 0-3 and we have a number from 0-19 Yay!
   280                          
   281  112f 69dc                   adc #$DC                            ; add 220 (will not be > 255, so no need to check carry)
   282  1131 6530                   adc SC_LSB                          ; now add the LSB
   283  1133 8536                   sta TB_LSB
   284  1135 9002                   bcc +                               ; incrememnt MSB if necessary
   285  1137 e637                   inc TB_MSB
   286                          +
   287  1139 b136                   lda (TB),y                          ; lets see what's at this timebomb location
   288  113b c920                   cmp #CHAR_PATH                      ; is it a space?
   289  113d d0da                   bne L27                             ; no, then try again
   290                          
   291  113f a92a                   lda #CHAR_BOMB                      ; plant the timebomb
   292  1141 9136                   sta (TB),y
   293                          
   294                          
   295                          ; 28 sys 830 : poke 828, 204 : poke 829, 28 : sys 923 : goto 4
   296                          ;===================================================================================================
   297                          ; SYS 830 - setup VIC and fill the colour memory
   298                          ;===================================================================================================
   299  1143 a9ee                   lda #$EE                            ; set the screen and border colours purple / light blue
   300  1145 8d0f90                 sta VIC_BORDER
   301                          
   302  1148 a90a                   lda #COLOUR_LIGHTRED                ; all text colour to light red
   303  114a 990096             -   sta COLOUR_RAM_PAGE0,y
   304  114d 990097                 sta COLOUR_RAM_PAGE1,y
   305  1150 c8                     iny
   306  1151 d0f7                   bne -
   307                          
   308  1153 a9cc                   lda #<MAZE_START_OFFSET             ; maze offset to $1CCC (middle left hand edge)
   309  1155 8542                   sta OFFSET_LSB
   310  1157 a91c                   lda #>MAZE_START_OFFSET

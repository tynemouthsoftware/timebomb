   121                          ;======================================================================================
   122                          
   123                          MAZE_WIDTH              = 22
   124                          MAZE_HEIGHT             = 66
   125                          
   126                          MAZE_END                = SCREEN_RAM - $0101
   127                          MAZE_TOP                = MAZE_END - (MAZE_HEIGHT * MAZE_WIDTH) + 1
   128                          
   129                          MAZE_END_OF_TOP_LINE    = MAZE_TOP + MAZE_WIDTH - 1
   130                          MAZE_START_OF_BOMB_LINE = MAZE_TOP + (MAZE_WIDTH * 10)
   131                          MAZE_DEBUG_OFFSET       = MAZE_TOP + (MAZE_WIDTH * 22)
   132                          MAZE_MIDDLE             = MAZE_TOP + (((MAZE_HEIGHT - 1) * MAZE_WIDTH) / 2 )
   133                          MAZE_LAST_LINE          = MAZE_END - MAZE_WIDTH + 1
   134                          MAZE_PLAYER_START       = MAZE_END - (MAZE_WIDTH * 2.5)
   135                          MAZE_START_OFFSET       = MAZE_END - (MAZE_WIDTH * 14) + 1
   136                          
   137                          SCREEN_LINE_ABOVE_ME    = SCREEN_RAM + (SCREEN_WIDTH * 11) - 1      ; 1EF1
   138                          SCREEN_START_ME         = SCREEN_RAM + (SCREEN_WIDTH * 11.5) - 1    ; 1EFC
   139                          SCREEN_LINE_BELOW_ME    = SCREEN_RAM + (SCREEN_WIDTH * 12)          ; 1F08

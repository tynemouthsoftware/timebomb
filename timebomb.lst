   809                          ;===================================================================================================
   810                          ; SYS 923 redraw screen
   811                          ;===================================================================================================
   812                          sys923:
   813  13e1 a000                   ldy #$00                            ; set the destination to the screen at 1E00
   814  13e3 8400                   sty SCREEN_LSB
   815  13e5 a91e                   lda #$1E
   816  13e7 8501                   sta SCREEN_MSB
   817                          
   818  13e9 ad3c03                 lda OFFSET_LSB                      ; set the source (the map bitmap)
   819  13ec 85fe                   sta MAP_LSB
   820  13ee ad3d03                 lda OFFSET_MSB
   821  13f1 85ff                   sta MAP_MSB
   822                          
   823  13f3 b1fe               -   lda (MAP),y                         ; copy first page
   824  13f5 9100                   sta (SCREEN),y
   825  13f7 c8                     iny
   826  13f8 d0f9                   bne -
   827                          
   828  13fa e601                   inc SCREEN_MSB
   829  13fc e6ff                   inc MAP_MSB
   830                          
   831  13fe b1fe               -   lda (MAP),y                         ; copy second page
   832  1400 9100                   sta (SCREEN),y
   833  1402 c8                     iny
   834  1403 d0f9                   bne -
   835                          
   836  1405 60                     rts

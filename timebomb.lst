   799  13a9 a91e                   lda #>SCREEN_RAM
   800  13ab 850b                   sta DST_MSB
   801                          
   802  13ad b108               -   lda (SRC),y                         ; copy character
   803  13af 910a                   sta (DST),y
   804                          
   805  13b1 e608                   inc SRC_LSB
   806  13b3 d010                   bne +
   807  13b5 e609                   inc SRC_MSB
   808  13b7 a509                   lda SRC_MSB
   809  13b9 c91e                   cmp #$1E                            ; check for end of map
   810  13bb d008                   bne +
   811  13bd a9cc                   lda #<MAZE_START_OFFSET             ; reset source to top starting offset
   812  13bf 8508                   sta SRC_LSB
   813  13c1 a91c                   lda #>MAZE_START_OFFSET
   814  13c3 8509                   sta SRC_MSB
   815                          
   816  13c5 e60a               +   inc DST_LSB
   817  13c7 d0e4                   bne -
   818  13c9 e60b                   inc DST_MSB
   819  13cb a50b                   lda DST_MSB                         ; check for end of screen RAM
   820  13cd c920                   cmp #$20                
   821  13cf d0dc                   bne -                               ; no finished yet, continue
   822                          
   823  13d1 60                     rts
   824                          
   825                          ;======================================================================================
   826                          ; Pseudo-random-number generator. You can get 8-bit
   827                          ; random numbers in A or 16-bit numbers from the zero
   828                          ; page addresses. Leaves X/Y unchanged.
   829                          ;
   830                          ; (36 clock cycles)
   831                          ;
   832                          ; See
   833                          ; https://web.archive.org/web/20250328001550/https://codebase64.org/doku.php?id=base:16bit_xorshift_random_generator
   834                          ; and
   835                          ; https://github.com/markgbeckett/pet/tree/main/examples
   836                          ;======================================================================================
   837                          RAND16:
   838  13d2 a511                   lda SEED_MSB                        ; (3)
   839  13d4 4a                     lsr			                        ; (2)
   840  13d5 a510                   lda SEED_LSB	                    ; (3)
   841  13d7 6a                     ror			                        ; (2)
   842  13d8 4511                   eor SEED_MSB	                    ; (3)
   843  13da 8511                   sta SEED_MSB	                    ; (3) high part of x ^= x << 7 done
   844  13dc 6a                     ror             	                ; (2) A has now x >> 9 and high bit comes from low byte
   845  13dd 4510                   eor SEED_LSB	                    ; (3)
   846  13df 8510                   sta SEED_LSB	                    ; (3) x ^= x >> 9 and the low part of x ^= x << 7 done
   847  13e1 4511                   eor SEED_MSB	                    ; (3)
   848  13e3 8511                   sta SEED_MSB	                    ; (3) x ^= x << 8 done
   849                          
   850  13e5 60                     rts			                        ; (6)
   851                          
   852                          ;======================================================================================
   853                          ; Strings
   854                          ;======================================================================================
   855                          
   856                          TEXT_ROUND_x:
   857  13e6 120f150e04202020       !scr    "round   "
   858                          
   859                          TEXT_PRESS_F7:
   860  13ee 1012051313200637       !scr    "press f7"
   861                          
   862                          TEXT_LEN  = 8
   863                          

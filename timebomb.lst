     6                          
     7                          ;======================================================================================
     8                          ; Write string to screen and set colour RAM
     9                          ;======================================================================================
    10                          !macro WriteString length, string, row, column, colour {
    11                              ldx #length-1                   ; WriteColourString Macro               
    12                          -   lda string,x
    13                              sta SCREEN_RAM + (LINE_LENGTH * row) + column,x
    14                              lda #colour
    15                              sta COLOUR_RAM + (LINE_LENGTH * row) + column,x
    16                              dex 
    17                              bpl -
    18                          }


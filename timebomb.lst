    15                          
    16                          ; BASIC loader stub
    17                          ; 6502 SYS 4109
    18                          *=$1001
    19  1001 0b10                   !word end_of_stub                   ; link to next line (end of BASIC stub)
    20  1003 6619                   !word 6502                          ; line number (can be anything, so why not)
    21  1005 9e                     !byte SYS                           ; SYS token
    22  1006 34313039               !text "4109"                        ; start of init code ($100D)
    23  100a 00                     !byte 0                             ; end of line
    24                          end_of_stub
    25  100b 0000                   !word 0                             ; end of BASIC stub
    26                          
    27                          ;===================================================================================================
    28                          ; Initialise
    29                          ;===================================================================================================
    30  100d ad1891                 lda VIA1_TIMER2_LSB                 ; seed RND from the VIA timer
    31  1010 8507                   sta SEED_LSB
    32  1012 ad1991                 lda VIA1_TIMER2_MSB
    33  1015 8508                   sta SEED_MSB
    34                          
    35                          start:
    36  1017 a000                   ldy #0                              ; (leave Y as 0)
    37                          
    38  1019 8432                   sty FOUND                           ; not found
    39  101b 842c                   sty ROUND_UNITS                     ; rount 0
    40  101d 842d                   sty ROUND_TENS                      ;
    41  101f 842e                   sty TIMER_UNITS                     ; timer 0
    42  1021 842f                   sty TIMER_TENS                      ;
    43  1023 8435                   sty PENALTY                         ; no penalty to start with
    44                          
    45  1025 a91e                   lda #CHAR_UP                        ; Initial player character facing North
    46  1027 8533                   sta PLAYER_CHARACTER
    47                          
    48                          ;===================================================================================================
    49                          ; Prepare the data structures
    50                          ;===================================================================================================
    51                          
    52                          ; All arrays are indexed on direction
    53                              ; 0 = right
    54                              ; 1 = up
    55                              ; 2 = left
    56                              ; 3 = down
    57                          
    58                          ; Build the single direction array
    59  1029 a901                   lda #MOVE_RIGHT
    60  102b 8510                   sta DIRECTION
    61  102d a9ea                   lda #MOVE_UP
    62  102f 8511                   sta DIRECTION + 1
    63  1031 a9ff                   lda #MOVE_LEFT
    64  1033 8512                   sta DIRECTION + 2
    65  1035 a916                   lda #MOVE_DOWN
    66  1037 8513                   sta DIRECTION + 3
    67                          
    68                          ; Build the double direction array
    69  1039 a902                   lda #2*MOVE_RIGHT
    70  103b 8514                   sta DOUBLE_DIRECTION
    71  103d a9d4                   lda #2*MOVE_UP
    72  103f 8515                   sta DOUBLE_DIRECTION + 1
    73  1041 a9fe                   lda #2*MOVE_LEFT
    74  1043 8516                   sta DOUBLE_DIRECTION + 2
    75  1045 a92c                   lda #2*MOVE_DOWN
    76  1047 8517                   sta DOUBLE_DIRECTION + 3
    77                          
    78                          ; build the direction character array
    79  1049 a93e                   lda #CHAR_RIGHT
    80  104b 8518                   sta CHAR_DIRECTION
    81  104d a91e                   lda #CHAR_UP
    82  104f 8519                   sta CHAR_DIRECTION + 1
    83  1051 a93c                   lda #CHAR_LEFT
    84  1053 851a                   sta CHAR_DIRECTION + 2
    85  1055 a916                   lda #CHAR_DOWN
    86  1057 851b                   sta CHAR_DIRECTION + 3
    87                          
    88                          ;===================================================================================================
    89                          ; fill maze with walls
    90                          ;===================================================================================================
    91  1059 a954                   lda #<MAZE_TOP                      ; DST points to the top of the maze
    92  105b 8505                   sta DST_LSB
    93  105d a917                   lda #>MAZE_TOP
    94  105f 8506                   sta DST_MSB
    95                          
    96  1061 a21d                   ldx #>MAZE_END+1                    ; pre-calculate the end point
    97                          
    98  1063 a9d1                   lda #CHAR_WALL                      ; fill with wall characters
    99                          -
   100  1065 9105                   sta (DST),y
   101  1067 e605                   inc DST_LSB
   102  1069 d0fa                   bne -
   103  106b e606                   inc DST_MSB
   104  106d e406                   cpx DST_MSB
   105  106f d0f4                   bne -
   106                          
   107                          ; add all the spaces down the right hand side
   108  1071 a917                   lda #>MAZE_END_OF_TOP_LINE          ; start at the end of the top line
   109  1073 8506                   sta DST_MSB
   110  1075 a969                   lda #<MAZE_END_OF_TOP_LINE
   111  1077 8505                   sta DST_LSB
   112                          
   113  1079 a242                   ldx #MAZE_HEIGHT                    ; 66 times
   114                          
   115  107b a920               -   lda #CHAR_PATH                      ; store a space
   116  107d 9105                   sta (DST),y
   117                          
   118  107f a505                   lda DST_LSB                         ; move down 1 line
   119  1081 18                     clc
   120  1082 6916                   adc #MAZE_WIDTH
   121  1084 8505                   sta DST_LSB
   122  1086 9002                   bcc +
   123  1088 e606                   inc DST_MSB
   124                          +
   125  108a ca                     dex                                 ; loop until complete
   126  108b d0ee                   bne -
   127                          
   128                          ; add a row of spaces at the top and bottom
   129  108d a920                   lda #CHAR_PATH                      ; store a space
   130  108f a216                   ldx #MAZE_WIDTH                     ; over the whole maze width
   131                          
   132  1091 ca                 -   dex
   133  1092 9d5417                 sta MAZE_TOP,x
   134  1095 9d001d                 sta MAZE_END+1,x
   135  1098 d0f7                   bne -
   136                          
   137                          ; leave a space where the player starts
   138  109a 8dc81c                 sta MAZE_PLAYER_START
   139                          
   140                          ;===================================================================================================
   141                          ; Build the paths
   142                          ;===================================================================================================
   143                          
   144                          ; start in the middle
   145  109d a91f                   lda #<MAZE_MIDDLE                   ; set current sqaureto the middle of the maze
   146  109f 8520                   sta CURRENT_SQUARE_LSB
   147  10a1 a91a                   lda #>MAZE_MIDDLE
   148  10a3 8521                   sta CURRENT_SQUARE_MSB
   149                          
   150                          next_move:
   151                          
   152                          ;######################## DEBUG ##################################
   153                          
   154                          ; DEBUG_SRC_LSB           = $F0
   155                          ; DEBUG_SRC_MSB           = $F1
   156                          ; DEBUG_SRC               = DEBUG_SRC_LSB
   157                          
   158                          ; DEBUG_DST_LSB           = $F2
   159                          ; DEBUG_DST_MSB           = $F3
   160                          ; DEBUG_DST               = DEBUG_DST_LSB
   161                          
   162                          ;     lda #COLOUR_BLUE                    ; all text colour to blue
   163                          ; -   sta COLOUR_RAM_PAGE0,y
   164                          ;     sta COLOUR_RAM_PAGE1,y
   165                          ;     iny
   166                          ;     bne -
   167                          
   168                          ;     lda #<MAZE_DEBUG_OFFSET
   169                          ;     sta DEBUG_SRC_LSB
   170                          ;     lda #>MAZE_DEBUG_OFFSET
   171                          ;     sta DEBUG_SRC_MSB
   172                          
   173                          ;     sty DEBUG_DST_LSB                   ; set the destination to the screen at 1E00
   174                          ;     lda #>SCREEN_RAM
   175                          ;     sta DEBUG_DST_MSB
   176                          
   177                          ; -   lda (DEBUG_SRC),y                   ; copy character
   178                          ;     cmp #4
   179                          ;     bcs +
   180                          ;     ;clc                                 ; 0-3 -> "0"-"3"
   181                          ;     ;adc #$30
   182                          ;     tax                                 ; 0-3 -> direction characters
   183                          ;     lda CHAR_DIRECTION,x
   184                          ; +
   185                          ;     sta (DEBUG_DST),y
   186                          
   187                          ;     inc DEBUG_SRC_LSB
   188                          ;     bne +
   189                          ;     inc DEBUG_SRC_MSB
   190                          
   191                          ; +   inc DEBUG_DST_LSB
   192                          ;     bne -
   193                          ;     inc DEBUG_DST_MSB
   194                          ;     lda DEBUG_DST_MSB                   ; check for end of screen RAM
   195                          ;     cmp #$20
   196                          ;     bne -                               ; not finished yet, continue
   197                          
   198                          ;     ldx #$08                            ; delay
   199                          ; -   dey                                 ;
   200                          ;     bne -                               ;
   201                          ;     dex                                 ;
   202                          ;     bne -                               ;
   203                          
   204                          ;#####################################################################
   205                          
   206                          
   207                          ; get a random direction
   208  10a5 20ac13                 jsr RAND16                          ; get a random number
   209  10a8 2903                   and #$03                            ; mask off all but the lower two bits (A=0-3)
   210                          
   211  10aa 8531                   sta DIRECTION_INDEX                 ; save the number
   212  10ac 8530                   sta INITIAL_DIRECTION
   213                          
   214                          start_path:
   215                          ; work out the location two squares in that direction
   216  10ae a521                   lda CURRENT_SQUARE_MSB              ; copy the MSB first
   217  10b0 8523                   sta CHECK_SQUARE_MSB
   218                          
   219  10b2 a631                   ldx DIRECTION_INDEX                 ; put the current direction into X
   220  10b4 b514                   lda DOUBLE_DIRECTION,x              ; get the signed direction offset
   221                          
   222  10b6 1002                   bpl +                               ; 2 places in the direction
   223  10b8 c623                   dec CHECK_SQUARE_MSB                ; if the offset is negative, decrement the MSB
   224  10ba 18                 +   clc
   225  10bb 6520                   adc CURRENT_SQUARE_LSB              ; now add the LSB
   226  10bd 8522                   sta CHECK_SQUARE_LSB
   227  10bf 9002                   bcc +
   228  10c1 e623                   inc CHECK_SQUARE_MSB                ; increment MSB if there was a carry
   229                          +
   230                          
   231                          ; is there a wall there?
   232  10c3 b122                   lda (CHECK_SQUARE),y                ; check what is at the check square (Y=0)
   233  10c5 c9d1                   cmp #CHAR_WALL                      ; is it a wall?
   234  10c7 d021                   bne not_wall                        ; no, a previous path or the edge, skip
   235                          
   236  10c9 8a                     txa                                 ; store the direction index there
   237  10ca 9122                   sta (CHECK_SQUARE),y
   238                          
   239                          ; work out the location of the square between here and where we just checked
   240  10cc b510                   lda DIRECTION,x                     ; get the signed direction offset
   241                          
   242  10ce 1002                   bpl +
   243  10d0 c621                   dec CURRENT_SQUARE_MSB              ; if the offset is negative, decrement the MSB
   244  10d2 18                 +   clc
   245  10d3 6520                   adc CURRENT_SQUARE_LSB              ; now add the LSB
   246  10d5 8520                   sta CURRENT_SQUARE_LSB
   247  10d7 9002                   bcc +
   248  10d9 e621                   inc CURRENT_SQUARE_MSB              ; increment MSB if there was a carry
   249                          +
   250                          
   251  10db a920                   lda #CHAR_PATH                      ; set this to a path (space)
   252  10dd 9120                   sta (CURRENT_SQUARE),y
   253                          
   254                          ; jump over the newly created space to the one we previously looked at
   255                          ; this is basically draughts
   256  10df a523                   lda CHECK_SQUARE_MSB
   257  10e1 8521                   sta CURRENT_SQUARE_MSB
   258  10e3 a522                   lda CHECK_SQUARE_LSB
   259  10e5 8520                   sta CURRENT_SQUARE_LSB
   260                          
   261  10e7 4ca510                 jmp next_move                       ; keep moving
   262                          
   263                          ; we hit a previous path or the edge of the screen
   264                          not_wall:
   265                              ; rotate 90 degrees counter-clockwise
   266                          
   267                              ; 0 = right -> up
   268                              ; 1 = up    -> left
   269                              ; 2 = left  -> down
   270                              ; 3 = down  -> right
   271                          
   272  10ea e631                   inc DIRECTION_INDEX                 ; 0123 > 1234
   273  10ec a531                   lda DIRECTION_INDEX                 ;
   274  10ee 2903                   and #$03                            ; 1234 > 1230
   275  10f0 8531                   sta DIRECTION_INDEX                 ;
   276                          
   277  10f2 c530                   cmp INITIAL_DIRECTION               ; are we back to the direction we started?
   278  10f4 d0b8                   bne start_path                      ; no, have another go
   279                          
   280                          ; check the current square
   281  10f6 b120                   lda (CURRENT_SQUARE),y              ; x is what is at the current square
   282  10f8 aa                     tax
   283                          
   284  10f9 a920                   lda #CHAR_PATH                      ; now make it a path
   285  10fb 9120                   sta (CURRENT_SQUARE),y
   286                          
   287  10fd e004                   cpx #4                              ; was it a previous direction index number?
   288  10ff b016                   bcs next_round                      ; no, we must be back at the start, the maze is complete
   289                          
   290                          ; we can't go any further from this point, in any direction, retrace our steps
   291  1101 b514                   lda DOUBLE_DIRECTION,x              ; get signed direction offset
   292  1103 8502                   sta TEMP                            ; save for later
   293  1105 1002                   bpl +
   294  1107 e621                   inc CURRENT_SQUARE_MSB              ; if the offset is negative, increment the MSB
   295  1109 38                 +   sec
   296  110a a520                   lda CURRENT_SQUARE_LSB              ; now subtract the offset from the LSB
   297  110c e502                   sbc TEMP
   298  110e 8520                   sta CURRENT_SQUARE_LSB
   299  1110 b002                   bcs +
   300  1112 c621                   dec CURRENT_SQUARE_MSB              ; decrement MSB if there was a carry
   301                          +
   302  1114 4ca510                 jmp next_move
   303                          
   304                          ;===================================================================================================
   305                          ; Start a new round
   306                          ;===================================================================================================
   307                          next_round:
   308  1117 8428                   sty OLD_PLAYER_LSB                  ; clear the old me position
   309  1119 8429                   sty OLD_PLAYER_MSB
   310                          
   311                          ; Set the location of the timebomb
   312                          ; the bomb is always on the 10th row from the top, but any position horizontally
   313                          select_bomb_location:
   314  111b a918                   lda #>MAZE_START_OF_BOMB_LINE       ; start with the MSB.
   315  111d 8525                   sta TIMEBOMB_MSB
   316                          
   317                          ; Get a random number from 0-19
   318                          ; LSB masked gives number from 0-3
   319                          ; MSB shifted into carry gives number 0-1
   320                          ; MSB remainder masked gives number from 0-15
   321                          ; total 0-19
   322                          
   323                          get_rand
   324  111f 20ac13                 jsr RAND16                          ; A now contains an 8 bit random number
   325  1122 2903                   and #$03                            ; now have number from 0-3
   326  1124 8502                   sta TEMP                            ; save for later
   327  1126 a507                   lda SEED_LSB                        ; get another 8 bits of random number
   328  1128 6a                     ror                                 ; shift 1 bit of that number into carry, 0-1
   329  1129 290f                   and #$0F                            ; now have a number from 0-15
   330  112b 6502                   adc TEMP                            ; now add the number from 0-3, and the 0-1 carry
   331                          
   332  112d 6930                   adc #<MAZE_START_OF_BOMB_LINE       ; add to the location
   333  112f 8524                   sta TIMEBOMB_LSB
   334  1131 9002                   bcc +                               ; incrememnt MSB if necessary
   335  1133 e625                   inc TIMEBOMB_MSB
   336                          +
   337                          
   338                          ; check timebomb location
   339  1135 b124                   lda (TIMEBOMB),y                    ; lets see what's at this timebomb location
   340  1137 c920                   cmp #CHAR_PATH                      ; is it a space?
   341  1139 d0e0                   bne select_bomb_location            ; no, then try again
   342                          
   343  113b a92a                   lda #CHAR_BOMB                      ; plant the timebomb
   344  113d 9124                   sta (TIMEBOMB),y
   345                          
   346                          ;===================================================================================================
   347                          ; Setup VIC and fill the colour memory
   348                          ;===================================================================================================
   349  113f a9ee                   lda #$EE                            ; set the screen and border colours purple / light blue
   350  1141 8d0f90                 sta VIC_BORDER
   351                          
   352  1144 a90a                   lda #COLOUR_LIGHTRED                ; all text colour to light red
   353  1146 990096             -   sta COLOUR_RAM_PAGE0,y
   354  1149 990097                 sta COLOUR_RAM_PAGE1,y
   355  114c c8                     iny
   356  114d d0f7                   bne -
   357                          
   358  114f a9cc                   lda #<MAZE_START_OFFSET             ; set the maze offset so player is in middle of screen
   359  1151 852a                   sta OFFSET_LSB
   360  1153 a91b                   lda #>MAZE_START_OFFSET
   361  1155 852b                   sta OFFSET_MSB
   362                          
   363  1157 207913                 jsr draw_screen                     ; draw the starting view of the maze
   364                          
   365                          ;===================================================================================================
   366                          ; Intro Sound
   367                          ;===================================================================================================
   368                          intro:
   369  115a a9f0                   lda #$F0                            ; Start at 240
   370                          
   371                          intro1:
   372  115c 990a90                 sta VIC_OSC1_FREQ, y                ; make the sound
   373  115f a200                   ldx #0
   374                          
   375                          intro2:
   376  1161 8e0e90                 stx VIC_VOLUME
   377                          
   378  1164 a20c                   ldx #$0C                            ; short delay
   379  1166 88                 -   dey                                 ;
   380  1167 d0fd                   bne -                               ;
   381  1169 ca                     dex                                 ;
   382  116a d0fa                   bne -                               ;
   383                          
   384  116c ae0e90                 ldx VIC_VOLUME                      ; get X back
   385  116f e8                     inx
   386  1170 e00f                   cpx #$0F
   387  1172 d0ed                   bne intro2
   388                          
   389  1174 8e0e90                 stx VIC_VOLUME                      ; set the volume to max
   390                          
   391  1177 38                     sec                                 ; drop the frequency
   392  1178 e904                   sbc #04
   393  117a c9d0                   cmp #$D0                            ; reached 208?
   394  117c b0de                   bcs intro1                          ; no
   395                          
   396  117e 8c0a90                 sty VIC_OSC1_FREQ                   ; stop the oscillator
   397                          
   398                          ; Position player
   399  1181 a9fc                   lda #<SCREEN_START_ME               ; position player in the middle of screen
   400  1183 8526                   sta PLAYER_LSB
   401  1185 a91e                   lda #>SCREEN_START_ME
   402  1187 8527                   sta PLAYER_MSB
   403                          
   404                          ;===================================================================================================
   405                          ; Main Loop
   406                          ;===================================================================================================
   407                          main_loop:
   408  1189 a5a2                   lda JIFFY_LSB                       ; wait until not an 8th frame
   409  118b 2907                   and #$07
   410  118d f0fa                   beq main_loop
   411                          
   412  118f a5a2               -   lda JIFFY_LSB                       ; wait until an 8th frame
   413  1191 2907                   and #$07
   414  1193 d0fa                   bne -
   415                          
   416                          ; clear previous player position
   417  1195 a920                   lda #CHAR_PATH                      ; first time around OLD_PLAYER is at $0000
   418  1197 9128                   sta (OLD_PLAYER),y
   419                          
   420                          ; clear the colour of that square
   421  1199 a529                   lda OLD_PLAYER_MSB                  ; add the offset from screen to colour RAM
   422  119b 18                     clc
   423  119c 6978                   adc #COLOUR_RAM_OFFSET_MSB
   424  119e 8506                   sta DST_MSB
   425                          
   426  11a0 a528                   lda OLD_PLAYER_LSB                  ; LSB remains the same
   427  11a2 8505                   sta DST_LSB
   428                          
   429  11a4 a90a                   lda #COLOUR_LIGHTRED                ; set to background colour
   430  11a6 9105                   sta (DST),y
   431                          
   432                          ; set new player position
   433  11a8 a533                   lda PLAYER_CHARACTER                ; set the direction character
   434  11aa 9126                   sta (PLAYER),y
   435                          
   436                          ; set the colour of that square
   437  11ac a527                   lda PLAYER_MSB                      ; add the offset from screen to colour RAM
   438  11ae 18                     clc
   439  11af 6978                   adc #COLOUR_RAM_OFFSET_MSB
   440  11b1 8506                   sta DST_MSB
   441                          
   442  11b3 a526                   lda PLAYER_LSB                      ; LSB remains the same
   443  11b5 8505                   sta DST_LSB
   444                          
   445  11b7 a907                   lda #COLOUR_YELLOW                  ; set player colour yellow
   446  11b9 9105                   sta (DST),y
   447                          
   448                          ; has the bomb been found?
   449  11bb a532                   lda FOUND                           ; check F, has player found the bomb?
   450  11bd f003                   beq +
   451  11bf 4cf512                 jmp bomb_found                      ; if so, round is complete
   452                          
   453                          ; incrememnt the timer
   454  11c2 e62e               +   inc TIMER_UNITS                     ; timer is stored as tens and units to simplify things
   455                          
   456  11c4 a52e                   lda TIMER_UNITS
   457  11c6 c90a                   cmp #10
   458  11c8 9004                   bcc +
   459  11ca e62f                   inc TIMER_TENS                      ; timer hit 10, increment tens
   460  11cc 842e                   sty TIMER_UNITS                     ; reset units (Y=0)
   461                          +
   462                          
   463                          ; only tick on alternate cycles
   464  11ce 6a                     ror                                 ; check bit 0, if clear it is odd, so skip ticking
   465  11cf 9028                   bcc check_joystick
   466                          
   467                          ; odd cycle, how are we doing?
   468  11d1 a52f                   lda TIMER_TENS                      ; only need to check the tens
   469  11d3 c93c                   cmp #60
   470  11d5 9003                   bcc tick                            ; we're ok, kiip ticking
   471  11d7 4c9d12                 jmp timed_out                       ; timed out, round over
   472                          
   473                          ;======================================================================================
   474                          ; Ominous ticking
   475                          ;======================================================================================
   476                          tick:
   477  11da a904                   lda #4                              ; pass 1, set volume to 4
   478                          
   479                          tock:
   480  11dc 8d0e90                 sta VIC_VOLUME                      ; v
   481                          
   482                              ; set vic oscillator based on remaining time
   483                              ; max TIMER_TENS is 60, doubled max is 120.
   484                              ; Range is 128-248
   485                          
   486  11df a52f                   lda TIMER_TENS                      ; get the tens
   487  11e1 0a                     asl                                 ; double it
   488  11e2 0980                   ora #$80                            ; add 128
   489                          
   490  11e4 8d0b90                 sta VIC_OSC2_FREQ                   ; set the frequency
   491                          
   492  11e7 a208                   ldx #$08
   493  11e9 88                 -   dey                                 ; short delay
   494  11ea d0fd                   bne -                               ;
   495  11ec ca                     dex                                 ;
   496  11ed d0fa                   bne -                               ;
   497                          
   498  11ef a908                   lda #8                              ; was VIC_VOLUME 8 already ?
   499  11f1 cd0e90                 cmp VIC_VOLUME
   500  11f4 d0e6                   bne tock                            ; no, loop again, this time at volume 8
   501                          
   502  11f6 8c0b90                 sty VIC_OSC2_FREQ                   ; disable the oscillator (Y=0)
   503                          
   504                          ;======================================================================================
   505                          ; Check joystick and move
   506                          ;======================================================================================
   507                          check_joystick:
   508  11f9 ad1f91                 lda VIA1_PORTA                      ; read port A where three of the joystick pins are
   509  11fc aa                     tax                                 ; save value
   510                          
   511  11fd 2908                   and #8
   512  11ff d004                   bne +                               ; skip if not zero (active)
   513  1201 a203                   ldx #DOWN                           ; set new direction
   514  1203 d025                   bne move_player                     ; jump always
   515                          +
   516  1205 8a                     txa                                 ; get back the port reading
   517  1206 2910                   and #16
   518  1208 d004                   bne +                               ; skip if not zero (active)
   519  120a a202                   ldx #LEFT                           ; set new direction
   520  120c d01c                   bne move_player
   521                          +
   522  120e 8a                     txa                                 ; get back the port reading
   523  120f 2904                   and #4
   524  1211 d004                   bne +                               ; skip if not zero (active)
   525  1213 a201                   ldx #UP                             ; set new direction
   526  1215 d013                   bne move_player
   527                          
   528                          +
   529  1217 a97f                   lda #$7F                            ; set joystick3 as input
   530  1219 8d2291                 sta VIA2_DDRB
   531                          
   532  121c ad2091                 lda VIA2_PORTB                      ; read the port
   533                          
   534  121f a2ff                   ldx #$FF
   535  1221 8e2291                 stx VIA2_DDRB                       ; back to all inputs for keyboard scanning
   536                          
   537  1224 2980                   and #$80                            ; mask of the pin
   538  1226 d033                   bne back_to_main_loop               ; nothing moving, back to main loop
   539  1228 a200                   ldx #RIGHT                          ; set new direction
   540                          
   541                          ; try to move the player
   542                          move_player:
   543  122a a526                   lda PLAYER_LSB                      ; save the old location
   544  122c 8528                   sta OLD_PLAYER_LSB
   545  122e a527                   lda PLAYER_MSB
   546  1230 8529                   sta OLD_PLAYER_MSB
   547                          
   548  1232 b518                   lda CHAR_DIRECTION,x                ; get new player direction character
   549  1234 8533                   sta PLAYER_CHARACTER
   550                          
   551  1236 b510                   lda DIRECTION,x                     ; get new player direction
   552  1238 1002                   bpl +
   553  123a c627                   dec PLAYER_MSB                      ; if direction is negative, decrement the MSB
   554  123c 18                 +   clc
   555  123d 6526                   adc PLAYER_LSB
   556  123f 8526                   sta PLAYER_LSB
   557  1241 9002                   bcc +
   558  1243 e627                   inc PLAYER_MSB
   559                          +
   560                          
   561                          ; check new location
   562  1245 b126                   lda (PLAYER),y
   563                          
   564  1247 c920                   cmp #CHAR_PATH                      ; is it a clear path?
   565  1249 f013                   beq ok_to_move                      ; yes, that's ok
   566                          
   567  124b c92a                   cmp #CHAR_BOMB                      ; is it a bomb?
   568  124d d004                   bne must_be_a_wall                  ; no
   569  124f e632                   inc FOUND                           ; yes, set found
   570  1251 d008                   bne back_to_main_loop               ; back to the main loop to tidy up first
   571                          
   572                          must_be_a_wall:
   573  1253 a528                   lda OLD_PLAYER_LSB                  ; me = old me - you can't want into walls
   574  1255 8526                   sta PLAYER_LSB
   575  1257 a529                   lda OLD_PLAYER_MSB
   576  1259 8527                   sta PLAYER_MSB
   577                          
   578                          back_to_main_loop:
   579  125b 4c8911                 jmp main_loop
   580                          
   581                          ; it is OK to move
   582                          ok_to_move:
   583                          
   584                          ; check if we need to scroll down now
   585  125e a527                   lda PLAYER_MSB                      ; is the player on the line above centre?
   586  1260 c91e                   cmp #>SCREEN_LINE_ABOVE_ME
   587  1262 d004                   bne +
   588  1264 a526                   lda PLAYER_LSB
   589  1266 c9f1                   cmp #<SCREEN_LINE_ABOVE_ME
   590                          +
   591  1268 b008                   bcs check_scroll_up
   592                          
   593                          ; yes, move the offset up and the player down
   594  126a a9ea                   lda #MOVE_UP                        ; offset = offset - 1 row
   595  126c c62b                   dec OFFSET_MSB                      ; pre-decrement MSB for subtraction
   596  126e a216                   ldx #MOVE_DOWN                      ; player = player + 1 row
   597  1270 d012                   bne scroll                          ; jump always
   598                          
   599                          check_scroll_up:
   600  1272 a527                   lda PLAYER_MSB                      ; is the player on the line below centre?
   601  1274 c91f                   cmp #>SCREEN_LINE_BELOW_ME
   602  1276 d004                   bne +
   603  1278 a526                   lda PLAYER_LSB
   604  127a c908                   cmp #<SCREEN_LINE_BELOW_ME
   605                          +
   606  127c 90dd                   bcc back_to_main_loop               ; no
   607                          
   608                          ; yes, move the offset down and the player up
   609  127e a916                   lda #MOVE_DOWN                      ; offset = offset + 1 row
   610  1280 a2ea                   ldx #MOVE_UP                        ; player = player - 1 row
   611  1282 c627                   dec PLAYER_MSB                      ; pre-decrement MSB for subtraction
   612                          
   613                          ; adjust offset view
   614                          scroll:
   615  1284 18                     clc                                 ; a contains + or - 1 row
   616  1285 652a                   adc OFFSET_LSB
   617  1287 852a                   sta OFFSET_LSB
   618  1289 9002                   bcc +
   619  128b e62b                   inc OFFSET_MSB
   620                          +
   621                          
   622                          ; move player back to the centre line
   623  128d 8a                     txa                                 ; x contains + or - 1 row
   624  128e 18                     clc
   625  128f 6526                   adc PLAYER_LSB
   626  1291 8526                   sta PLAYER_LSB
   627  1293 9002                   bcc +
   628  1295 e627                   inc PLAYER_MSB
   629                          +
   630                          
   631                          ; redraw the screen
   632  1297 207913                 jsr draw_screen
   633                          
   634                          ; back to the start
   635  129a 4c8911                 jmp main_loop
   636                          
   637                          
   638                          ;===================================================================================================
   639                          ; Timeout, bomb explodes
   640                          ;===================================================================================================
   641                          timed_out:
   642  129d a90f                   lda #$0F                            ; set full volume
   643  129f 8d0e90                 sta VIC_VOLUME
   644                          
   645  12a2 a2ff                   ldx #$FF                            ; start at 255
   646                          fizz:
   647  12a4 8e0a90                 stx VIC_OSC1_FREQ                   ; set the frequency
   648                          
   649                          ; change the addressing to mess up the screen
   650  12a7 a9ff                   lda #$FF
   651  12a9 8d0590                 sta VIC_ADDRESSING
   652                          
   653  12ac a209                   ldx #$09                            ; short delay
   654  12ae 88                 -   dey                                 ;
   655  12af d0fd                   bne -                               ;
   656  12b1 ca                     dex                                 ;
   657  12b2 d0fa                   bne -                               ;
   658                          
   659                          ; change the addressing to mess up the screen
   660  12b4 a9f2                   lda #$F2
   661  12b6 8d0590                 sta VIC_ADDRESSING                  ; v-9 = 242
   662                          
   663  12b9 a209                   ldx #$09                            ; short delay
   664  12bb 88                 -   dey                                 ;
   665  12bc d0fd                   bne -                               ;
   666  12be ca                     dex                                 ;
   667  12bf d0fa                   bne -                               ;
   668                          
   669  12c1 a9f0                   lda #$F0
   670  12c3 8d0590                 sta VIC_ADDRESSING                  ; v-9 = 240
   671                          
   672  12c6 ae0a90                 ldx VIC_OSC1_FREQ                   ; what's the frequency Kenneth?
   673  12c9 ca                     dex                                 ; reduce it
   674  12ca ca                     dex
   675  12cb 30d7                   bmi fizz                            ; loop when until < 128
   676                          
   677                              ; now the explosion
   678                          
   679  12cd a9dc                   lda #$DC                            ; set the noise frequency
   680  12cf 8d0d90                 sta VIC_NOISE_FREQ
   681                          
   682  12d2 a996                   lda #$96                            ; change the colours
   683  12d4 8d0f90                 sta VIC_BORDER
   684                          
   685  12d7 a20a                   ldx #$0A                            ; loop 10 times
   686                          
   687                          flash:
   688  12d9 88                     dey                                 ; delay
   689  12da d0fd                   bne flash
   690                          
   691  12dc ce0f90                 dec VIC_BORDER                      ; flash the border colour
   692  12df ca                     dex
   693  12e0 d0f7                   bne flash
   694                          
   695  12e2 ce0e90                 dec VIC_VOLUME                      ; reduce the colume
   696  12e5 d0f2                   bne flash
   697                          
   698                          ; silence
   699  12e7 8c0d90                 sty VIC_NOISE_FREQ                  ; stop the noice
   700                          
   701  12ea a9ee                   lda #$EE                            ; back to normal
   702  12ec 8d0f90                 sta VIC_BORDER
   703                          
   704  12ef 203d13                 jsr end_of_round                    ; display "ROUND R, PRESS F7"
   705                          
   706  12f2 4c1710                 jmp start                           ; restart with a new maze (since you blew the old one up)
   707                          
   708                          ;===================================================================================================
   709                          ; Success
   710                          ;===================================================================================================
   711                          bomb_found:
   712  12f5 a920                   lda #CHAR_PATH                      ; dispose of the timebomb
   713  12f7 9124                   sta (TIMEBOMB),y
   714                          
   715  12f9 a9fd                   lda #$FD
   716  12fb 8d0d90                 sta VIC_NOISE_FREQ                  ; defusing noise
   717                          
   718  12fe a20f                   ldx #$0F                            ; g = 30, x = g/2 = 15
   719                          
   720                          defuse:
   721  1300 8e0e90                 stx VIC_VOLUME                      ; v = g/2 = x
   722                          
   723  1303 a235                   ldx #$35                            ; delay
   724  1305 88                 -   dey                                 ;
   725  1306 d0fd                   bne -                               ;
   726  1308 ca                     dex                                 ;
   727  1309 d0fa                   bne -                               ;
   728                          
   729  130b ae0e90                 ldx VIC_VOLUME                      ; get X back
   730                          
   731  130e ca                     dex
   732  130f d0ef                   bne defuse
   733                          
   734                          ; reduce the available time for the next round
   735  1311 18                     clc
   736  1312 a535                   lda PENALTY                         ; add 5 seconds penalty
   737  1314 6905                   adc #$05
   738  1316 8535                   sta PENALTY
   739                          
   740  1318 c92d                   cmp #$2D                            ; have we gone too far?
   741  131a 9004                   bcc +
   742  131c a92d                   lda #$2D                            ; limit the maximum penalty
   743  131e 8535                   sta PENALTY
   744                          +
   745                          
   746  1320 8c0d90                 sty VIC_NOISE_FREQ                  ; stop the noise
   747  1323 8432                   sty FOUND                           ; the bomb has not been found
   748                          
   749  1325 a535                   lda PENALTY                         ; start the timer, with the penalty
   750  1327 852f                   sta TIMER_TENS
   751  1329 842e                   sty TIMER_UNITS
   752                          
   753                          ; increment the round number
   754  132b e62c                   inc ROUND_UNITS
   755  132d a52c                   lda ROUND_UNITS
   756  132f c90a                   cmp #10                             ; has it reached 10?
   757  1331 9004                   bcc +
   758  1333 842c                   sty ROUND_UNITS                     ; clear and increment the 10s count
   759  1335 e62d                   inc ROUND_TENS
   760                          +
   761  1337 203d13                 jsr end_of_round                    ; display "ROUND R, PRESS F7"
   762                          
   763  133a 4c1711                 jmp next_round                      ; next round
   764                          
   765                          ;===================================================================================================
   766                          ; end of round, print ROUND R - PRESS F7
   767                          ;===================================================================================================
   768                          end_of_round:
   769  133d a207                   ldx #TEXT_LEN-1                     ; write out two 8 character strings
   770                          
   771  133f bdc013             -   lda TEXT_ROUND_x,x                  ; "ROUND   "
   772  1342 9d001e                 sta SCREEN_RAM_LINE_00,x
   773  1345 bdc813                 lda TEXT_PRESS_F7,x                 ; "PRESS F7"
   774  1348 9d2c1e                 sta SCREEN_RAM_LINE_02,x
   775                          
   776  134b a906                   lda #COLOUR_BLUE                    ; both blue
   777  134d 9d0096                 sta COLOUR_RAM_LINE_00,x
   778  1350 9d2c96                 sta COLOUR_RAM_LINE_02,x
   779                          
   780  1353 ca                     dex
   781  1354 10e9                   bpl -
   782                          
   783                          ; display the round number
   784  1356 a52d                   lda ROUND_TENS                      ; any tens?
   785  1358 f010                   beq single
   786                          
   787                              ; double digit
   788  135a 18                     clc                                 ; make printable (0->"0")
   789  135b 6930                   adc #$30
   790  135d 8d061e                 sta SCREEN_RAM + 6
   791                          
   792  1360 a52c                   lda ROUND_UNITS
   793  1362 18                     clc                                 ; make printable (0->"0")
   794  1363 6930                   adc #$30
   795  1365 8d071e                 sta SCREEN_RAM + 7
   796  1368 d008                   bne check_key                       ; branch always
   797                          
   798                          single:
   799                              ; single digit
   800  136a a52c                   lda ROUND_UNITS
   801  136c 18                     clc                                 ; make printable (0->"0")
   802  136d 6930                   adc #$30
   803  136f 8d061e                 sta SCREEN_RAM + 6
   804                          
   805                          check_key:
   806  1372 a5c5                   lda LAST_KEY                        ; check last key pressed
   807  1374 c93f                   cmp #KEY_F7                         ; was it F7?
   808  1376 d0fa                   bne check_key                       ; no, keep checking
   809                          
   810  1378 60                     rts                                 ; yes, return
   811                          
   812                          ;===================================================================================================
   813                          ; redraw the screen
   814                          ;===================================================================================================
   815                          draw_screen:
   816  1379 a52a                   lda OFFSET_LSB                      ; set the source (offset into the map bitmap)
   817  137b 8503                   sta SRC_LSB
   818  137d a52b                   lda OFFSET_MSB
   819  137f 8504                   sta SRC_MSB
   820                          
   821  1381 8405                   sty DST_LSB                         ; set the destination to the screen RAM
   822  1383 a91e                   lda #>SCREEN_RAM
   823  1385 8506                   sta DST_MSB
   824                          
   825  1387 b103               -   lda (SRC),y                         ; copy character
   826  1389 9105                   sta (DST),y
   827                          
   828  138b e603                   inc SRC_LSB                         ; move the source pointer
   829  138d d010                   bne +
   830  138f e604                   inc SRC_MSB
   831  1391 a504                   lda SRC_MSB                         ; at the end?
   832  1393 c91d                   cmp #>MAZE_END+1
   833  1395 d008                   bne +
   834                          
   835  1397 a9cc                   lda #<MAZE_START_OFFSET             ; end of maze, duplicate the end section again
   836  1399 8503                   sta SRC_LSB
   837  139b a91b                   lda #>MAZE_START_OFFSET
   838  139d 8504                   sta SRC_MSB
   839                          
   840  139f e605               +   inc DST_LSB                         ; move the destination pointer
   841  13a1 d0e4                   bne -
   842  13a3 e606                   inc DST_MSB
   843  13a5 a506                   lda DST_MSB                         ; check for end of screen RAM
   844  13a7 c920                   cmp #>END_OF_SCREEN_RAM+1
   845  13a9 d0dc                   bne -                               ; not finished yet, continue
   846                          
   847  13ab 60                     rts
   848                          
   849                          ;======================================================================================
   850                          ; Pseudo-random-number generator. You can get 8-bit random numbers in A
   851                          ; or 16-bit numbers from the zero page addresses. Leaves X/Y unchanged.
   852                          ;
   853                          ; (36 clock cycles)
   854                          ;
   855                          ; See
   856                          ; https://web.archive.org/web/20250328001550/https://codebase64.org/doku.php?id=base:16bit_xorshift_random_generator
   857                          ; and
   858                          ; https://github.com/markgbeckett/pet/tree/main/examples
   859                          ;======================================================================================
   860                          RAND16:
   861  13ac a508                   lda SEED_MSB                        ; (3)
   862  13ae 4a                     lsr			                        ; (2)
   863  13af a507                   lda SEED_LSB	                    ; (3)
   864  13b1 6a                     ror			                        ; (2)
   865  13b2 4508                   eor SEED_MSB	                    ; (3)
   866  13b4 8508                   sta SEED_MSB	                    ; (3) high part of x ^= x << 7 done
   867  13b6 6a                     ror             	                ; (2) A has now x >> 9 and high bit comes from low byte
   868  13b7 4507                   eor SEED_LSB	                    ; (3)
   869  13b9 8507                   sta SEED_LSB	                    ; (3) x ^= x >> 9 and the low part of x ^= x << 7 done
   870  13bb 4508                   eor SEED_MSB	                    ; (3)
   871  13bd 8508                   sta SEED_MSB	                    ; (3) x ^= x << 8 done
   872                          
   873  13bf 60                     rts			                        ; (6)
   874                          
   875                          ;======================================================================================
   876                          ; Strings
   877                          ;======================================================================================
   878                          TEXT_ROUND_x:
   879  13c0 120f150e04202020       !scr    "round   "
   880                          
   881                          TEXT_PRESS_F7:
   882  13c8 1012051313200637       !scr    "press f7"
   883                          
   884                          TEXT_LEN  = 8
   885                          
   886                          
